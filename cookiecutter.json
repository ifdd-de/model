{
  "ifdd_model_prj_name": "IFDD Model Content",
  "ifdd_model_prj_slug": "{{ cookiecutter.ifdd_model_prj_name|lower|replace(' ', '_') }}",
  "ifdd_schema_url": "http://schema/v1",
  "ifdd_type_url": "http://type/v1",
  "ifdd_unit_url": "http://unit/v1",
  "ifdd_model_host": "model",
  "ifdd_model_dev_port": "8084",
  "ifdd_model_autoindex": "y",
  "ifdd_model_cors_origin": "*",
  "ifdd_model_cache_max_age": "300",
  "ifdd_model_memory_limit": "128M",
  "ifdd_model_content_dir": "./src/linkml",
  "ifdd_nginx_image": "nginx/nginx-unprivileged:1.30.8-alpine-slim",
  "ifdd_proxy_network": "proxy-net",
  "_copy_without_render": [
    ".github",
    "docgen",
    "ifdd_model",
    "justfile",
    "src",
    "tests"
  ]
}
