{#- One MyST page per namespace, rendered by gen-doc through index.md.jinja2
    (variable lang). Both languages share this file, so files, labels and
    heading levels match (tests/check_docs.py). Labels: ifdd-model-ns-<name>;
    ifdd-model-<page> belongs to the operating documentation in docs/. -#}
{%- set T = {
  "en": {"namespace": "Namespace", "context": "JSON-LD context", "vocabulary": "Vocabulary",
         "version": "Version", "source": "LinkML source", "no_context": "none (vocabulary only)",
         "property": "Property", "value": "Value", "diagram": "Diagram", "terms": "Terms", "value_list": "Values",
         "term": "Term", "label": "Label", "description": "Description", "range": "Range", "notes": "Notes",
         "order": "order", "list": "list", "kind": "quantity kind", "units": "units", "min": "min", "max": "max",
         "name": "Name", "symbol": "Symbol", "qudt": "QUDT", "iri": "IRI", "string": "text"},
  "de": {"namespace": "Namensraum", "context": "JSON-LD-Context", "vocabulary": "Vokabular",
         "version": "Version", "source": "LinkML-Quelle", "no_context": "keiner (nur Vokabular)",
         "property": "Eigenschaft", "value": "Wert", "diagram": "Diagramm", "terms": "Begriffe", "value_list": "Werte",
         "term": "Term", "label": "Bezeichnung", "description": "Beschreibung", "range": "Wertebereich",
         "notes": "Hinweise", "order": "Reihenfolge", "list": "Liste", "kind": "Größenart", "units": "Einheiten",
         "min": "min.", "max": "max.", "name": "Name", "symbol": "Symbol", "qudt": "QUDT", "iri": "IRI",
         "string": "Text"},
}[lang] -%}
{%- macro text(e, key) -%}
{%- set de_key = key ~ "_de" -%}
{%- if lang == "de" and e.annotations and e.annotations[de_key] is defined -%}
{{ e.annotations[de_key].value }}
{%- elif key == "title" -%}{{ e.title or e.name }}
{%- else -%}{{ e.description or "" }}
{%- endif -%}
{%- endmacro -%}
{%- macro cell(s) -%}{{ s | replace("|", "\\|") | replace("\n", " ") }}{%- endmacro -%}
{%- macro last(iri) -%}{{ iri.rstrip("/").split("/")[-1].split(":")[-1] }}{%- endmacro -%}
{%- set own = schema.default_prefix ~ ":schema" -%}
{%- set mains = schemaview.all_classes(imports=False).values() | selectattr("class_uri", "equalto", own) | list -%}
{%- set main = mains[0] if mains else None -%}
{%- set enums = schemaview.all_enums(imports=False).values() | list -%}
{%- set service = "unit" if enums else "type" -%}
(ifdd-model-ns-{{ schema.name | replace(".", "-") }})=
# {{ text(schema, "title") }}

{{ text(schema, "description") }}

| {{ T.property }} | {{ T.value }} |
|---|---|
| {{ T.namespace }} | `{{ schema.id }}` |
{%- if service == "type" %}
| {{ T.context }} | {% if main %}`schema/json-ld/v1/{{ schema.name }}.jsonld`{% else %}{{ T.no_context }}{% endif %} |
{%- endif %}
| {{ T.vocabulary }} | `{{ service }}/json-ld/v1/{{ schema.name }}/index.jsonld` |
| {{ T.version }} | {{ schema.version or "–" }} |
| {{ T.source }} | `src/linkml/{{ service }}/{{ schema.name }}.yaml` |
{% if main %}
## {{ T.diagram }}

```{uml}
{{ gen.mermaid_diagram(schemaview.all_classes(imports=False) | list) }}
```
{% endif %}
{%- if enums %}
## {{ T.value_list }}

| {{ T.name }} | {{ T.label }} | {{ T.description }} | {{ T.symbol }} | {{ T.kind }} | {{ T.qudt }} |
|---|---|---|---|---|---|
{%- for e in enums %}{% for key, pv in e.permissible_values.items() %}
| `{{ key }}` | {{ cell(text(pv, "title")) }} | {{ cell(text(pv, "description")) }} | {{ pv.unit.symbol if pv.unit and pv.unit.symbol else "" }} | {{ last(pv.unit.has_quantity_kind) if pv.unit and pv.unit.has_quantity_kind else "" }} | `{{ pv.exact_mappings | join(", ") }}` |
{%- endfor %}{% endfor %}
{%- else %}
## {{ T.terms }}

| {{ T.term }} | {{ T.label }} | {{ T.description }} | {{ T.range }} | {{ T.notes }} |
|---|---|---|---|---|
{%- set names = schemaview.class_slots(main.name) if main else schemaview.all_slots(imports=False) | list -%}
{%- set ns = namespace(rows=[]) -%}
{%- for sn in names %}{% set ns.rows = ns.rows + [schemaview.induced_slot(sn, main.name) if main else schemaview.induced_slot(sn)] %}{% endfor %}
{%- for s in ns.rows | sort(attribute="rank") %}
{%- set notes = [T.order ~ " " ~ s.rank] -%}
{%- if s.multivalued %}{% set notes = notes + [T.list] %}{% endif -%}
{%- if s.annotations and s.annotations.quantity_kind is defined %}{% set notes = notes + [T.kind ~ " " ~ last(s.annotations.quantity_kind.value)] %}{% endif -%}
{%- if s.annotations and s.annotations.applicable_units is defined -%}
{%- set us = namespace(names=[]) -%}
{%- for u in s.annotations.applicable_units.value.split() %}{% set us.names = us.names + [last(u)] %}{% endfor -%}
{%- set notes = notes + [T.units ~ " " ~ (us.names | join(", "))] -%}
{%- endif -%}
{%- if s.minimum_value is not none %}{% set notes = notes + [T.min ~ " " ~ s.minimum_value] %}{% endif -%}
{%- if s.maximum_value is not none %}{% set notes = notes + [T.max ~ " " ~ s.maximum_value] %}{% endif -%}
{%- if s.range in schemaview.all_classes() -%}
{%- set target = schemaview.get_class(s.range).class_uri -%}
{%- if target.endswith("/schema") or target == own -%}
{#- an IFDD namespace: link to its page -#}
{%- set tname = schema.name if target == own else target.split("/")[-2] -%}
{%- set rng = "{ref}`ifdd-model-ns-" ~ (tname | replace(".", "-")) ~ "`" -%}
{%- else -%}
{%- set rng = "`" ~ target ~ "`" -%}
{%- endif -%}
{%- elif s.range == "uriorcurie" -%}{%- set rng = T.iri -%}
{%- elif s.range in [None, "string"] -%}{%- set rng = T.string -%}
{%- else -%}{%- set rng = "`" ~ schemaview.get_type(s.range).uri ~ "`" -%}
{%- endif %}
| `{{ s.name }}` | {{ cell(text(s, "title")) }} | {{ cell(text(s, "description")) }} | {{ rng }} | {{ notes | join(", ") }} |
{%- endfor %}
{%- endif %}
